# ============================================================
# VortexUI — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ============================================================

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_VERSION=1.0.0

# --- Analytics ---
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# --- Email Service Provider (ESP) ---
# Replace with your actual ESP credentials
# Examples: ActiveCampaign, Mailchimp, Brevo, RD Station
# ACTIVE_CAMPAIGN_API_URL=https://your-account.api-us1.com
# ACTIVE_CAMPAIGN_API_KEY=your-api-key

# --- Database (optional, for lead persistence) ---
# DATABASE_URL=postgresql://user:password@host:5432/vortexui

